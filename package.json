{
  "name": "obsidian-echarts-lite",
  "version": "1.1.3",
  "description": "echarts plugin for obsidian, compatible with mobile.",
  "keywords": [
    "chart",
    "echarts",
    "obsidian",
    "visualization"
  ],
  "license": "MIT",
  "author": "xjiaxiang",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && cp manifest.json dist/",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt",
    "fmt:fix": "oxfmt --fix",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "echarts-wordcloud": "^2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "25.6.0",
    "builtin-modules": "5.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "memfs": "4.80.0",
    "obsidian": "latest",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
